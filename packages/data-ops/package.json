{
  "name": "@repo/data-ops",
  "version": "1.0.0",
  "description": "Manage auth, database, schemas, and queries",
  "exports": {
    "./auth/*": {
      "default": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./database/*": {
      "default": "./dist/database/*.js",
      "types": "./dist/database/*.d.ts"
    },
    "./zod-schema/*": {
      "default": "./dist/zod-schema/*.js",
      "types": "./dist/zod-schema/*.d.ts"
    },
    "./queries/*": {
      "default": "./dist/queries/*.js",
      "types": "./dist/queries/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "typecheck": "tsc --noEmit",
    "better-auth:generate": "auth generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts --yes",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "drizzle:pull": "drizzle-kit pull --config drizzle.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@planetscale/database": "^1.19.0",
    "better-auth": "1.6.34",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/better-sqlite3": "^7.6.13",
    "auth": "1.6.34",
    "drizzle-kit": "0.31.11",
    "mysql2": "^3.24.6",
    "postgres": "^3.4.7",
    "tsc-alias": "^1.8.16",
    "typescript": "6.0.3"
  }
}
