---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { NavigationIsland } from "@/components/navigation/navigation-island";
import { HeroSection } from "@/components/landing/hero-section";
import { ClaudeCodeSection } from "@/components/landing/claude-code-section";
import { FeaturesSection } from "@/components/landing/features-section";
import { CoursePromoSection } from "@/components/landing/course-promo-section";
import { Footer } from "@/components/landing/footer";
---

<BaseLayout>
  <div class="min-h-screen bg-background">
    <NavigationIsland client:load />
    <main>
      <HeroSection />
      <ClaudeCodeSection />
      <FeaturesSection />
      <CoursePromoSection />
    </main>
    <Footer />
  </div>
</BaseLayout>
